{
  "version": 1,
  "nodes": {
    "n_uv":    {"type": "TexCoord",       "inputs": {}},
    "n_noise": {"type": "NoiseTexture",   "inputs": {"vector": ["n_uv", "uv"], "scale": 4.0}},
    "n_a":     {"type": "RGB",            "inputs": {"color": [0.05, 0.1, 0.4]}},
    "n_b":     {"type": "RGB",            "inputs": {"color": [0.9, 0.6, 0.2]}},
    "n_mix":   {"type": "MixColor",       "inputs": {"fac": ["n_noise", "fac"], "a": ["n_a", "color_out"], "b": ["n_b", "color_out"]}},
    "n_bsdf":  {"type": "PrincipledBSDF", "inputs": {"base_color": ["n_mix", "result"], "roughness": 0.35}}
  },
  "output": ["n_bsdf", "bsdf"]
}
